# Canonical public URL used for sitemap, RSS, robots.txt, and social cards.
# In Vercel, set this after the custom domain is connected.
PUBLIC_SITE_URL=https://your-domain.com

# R2 gallery upload helper used by `npm run new:r2-photo`.
# Keep real keys in `.env.local` or your shell environment, not in Git.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=rapture-images
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://img.your-domain.com
R2_PREFIX=rapture/gallery
R2_THUMB_SIZE=1100
R2_THUMB_QUALITY=78
