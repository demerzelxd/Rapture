<section class="rapture-hero" id="entry" aria-label="Rapture entry">
  <canvas class="ink-canvas" data-aquainkgl-canvas aria-hidden="true"></canvas>
  <script is:inline src="/aquainkgl/aquainkgl.js?v=2026-06-21-upstream-aquainkgl"></script>
  <div class="hero-noise" aria-hidden="true"></div>
  <p class="hero-kicker">A private city beneath the surface</p>
  <div class="hero-content">
    <div class="hero-blend">
      <h1>Rapture</h1>
      <p class="hero-quote">
        I chose the impossible.<br />
        I chose... Rapture.
      </p>
    </div>
  </div>
  <div class="hero-actions" aria-label="Content entrances">
    <a href="/blog/">Writing</a>
    <a href="/gallery/">Gallery</a>
  </div>
  <a class="scroll-cue" href="#main-content" data-enter-city>Enter the city</a>
  <script is:inline>
    (() => {
      const trigger = document.querySelector('[data-enter-city]');
      if (!(trigger instanceof HTMLAnchorElement)) return;

      let settleTimer = 0;
      trigger.addEventListener('click', (event) => {
        const target = document.querySelector('#main-content');
        if (!(target instanceof HTMLElement)) return;
        event.preventDefault();
        const top = window.scrollY + target.getBoundingClientRect().top + 1;
        const finalTop = Math.max(0, top);
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.history.replaceState(null, '', '#main-content');
        window.scrollTo({
          top: finalTop,
          behavior: reducedMotion ? 'instant' : 'smooth',
        });
        window.clearTimeout(settleTimer);
        settleTimer = window.setTimeout(() => {
          window.scrollTo({ top: finalTop, behavior: 'instant' });
        }, reducedMotion ? 0 : 760);
      });
    })();
  </script>
</section>

