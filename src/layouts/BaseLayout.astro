---
import '../styles/global.css';
import { absoluteUrl, SITE_NAME, SITE_DESCRIPTION } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  preloadInk?: boolean;
  canonicalPath?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  preloadInk = false,
  canonicalPath,
  image = '/og-image.png',
  type = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;
const canonicalUrl = absoluteUrl(canonicalPath ?? Astro.url.pathname);
const imageUrl = absoluteUrl(image);
const baseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: absoluteUrl('/'),
};
const jsonLdEntries = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const jsonLdPayload = [baseJsonLd, ...jsonLdEntries].filter(Boolean);
const jsonLdText = JSON.stringify(jsonLdPayload).replaceAll('<', '\\u003c');
const currentPath = Astro.url.pathname;
const currentSection = currentPath.startsWith('/blog/')
  ? 'blog'
  : currentPath.startsWith('/gallery/')
    ? 'gallery'
    : currentPath.startsWith('/archive/')
      ? 'archive'
      : currentPath === '/'
        ? 'home'
        : 'none';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#05070a" />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} writing feed`} href={absoluteUrl('/rss.xml')} />
    <link rel="alternate" type="application/feed+json" title={`${SITE_NAME} updates feed`} href={absoluteUrl('/feed.json')} />
    <link rel="alternate" type="application/json" title={`${SITE_NAME} content index`} href={absoluteUrl('/content.json')} />
    <link rel="search" type="application/opensearchdescription+xml" title={`${SITE_NAME} search`} href={absoluteUrl('/opensearch.xml')} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {preloadInk && <link rel="preload" href="/aquainkgl/aquainkgl.js?v=2026-06-21-upstream-aquainkgl" as="script" />}
    {preloadInk && <link rel="preload" href="/aquainkgl/LDR_LLL1_0.png" as="image" />}
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,500;1,600&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={jsonLdText} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header" aria-label="Primary navigation">
        <a class="site-mark" href="/" aria-label="Rapture home">
          <span class="site-mark-text">Rapture</span>
        </a>
        <nav class="site-nav">
          <a href="/" aria-current={currentSection === 'home' ? 'page' : undefined}>Entry</a>
          <a href="/blog/" aria-current={currentSection === 'blog' ? 'page' : undefined}>Writing</a>
          <a href="/gallery/" aria-current={currentSection === 'gallery' ? 'page' : undefined}>Gallery</a>
          <a href="/archive/" aria-current={currentSection === 'archive' ? 'page' : undefined}>Archive</a>
        </nav>
      </header>
      <div class="command-palette" data-command-palette hidden>
        <button class="command-palette-backdrop" type="button" data-command-close aria-label="Close command palette"></button>
        <section class="command-console" role="dialog" aria-modal="true" aria-label="Rapture command palette">
          <label class="command-input-row">
            <span aria-hidden="true">&gt;</span>
            <input
              id="command-search"
              name="command"
              data-command-input
              type="search"
              autocomplete="off"
              spellcheck="false"
              placeholder="Search command, dispatch, frame..."
              aria-label="Search Rapture commands"
              aria-controls="command-results"
              aria-activedescendant=""
            />
          </label>
          <div id="command-results" class="command-results" data-command-results role="listbox" aria-label="Command results"></div>
          <p class="command-hint">Enter opens / arrows move / Esc closes</p>
        </section>
      </div>
      <script is:inline>
        (() => {
          const root = document.documentElement;
          const header = document.querySelector('.site-header');
          if (!(header instanceof HTMLElement)) return;

          const updateAnchorOffset = () => {
            const headerBottom = Math.max(0, Math.ceil(header.getBoundingClientRect().bottom));
            const breathingRoom = Math.max(2, Math.round((parseFloat(getComputedStyle(root).fontSize) || 16) * 0.125));
            root.style.setProperty('--measured-header-offset', `${headerBottom + breathingRoom}px`);
          };

          updateAnchorOffset();
          window.addEventListener('load', updateAnchorOffset, { once: true });
          window.addEventListener('resize', updateAnchorOffset, { passive: true });
          window.addEventListener('orientationchange', () => requestAnimationFrame(updateAnchorOffset), { passive: true });

          if ('ResizeObserver' in window) {
            new ResizeObserver(updateAnchorOffset).observe(header);
          }
        })();
      </script>
      <script is:inline>
        (() => {
          const palette = document.querySelector('[data-command-palette]');
          const input = palette?.querySelector('[data-command-input]');
          const results = palette?.querySelector('[data-command-results]');
          const closeButton = palette?.querySelector('[data-command-close]');

          if (!(palette instanceof HTMLElement) || !(input instanceof HTMLInputElement) || !(results instanceof HTMLElement)) return;

          const staticCommands = [
            { label: 'Entry', detail: 'Return to the ink gate', url: '/', keywords: 'home hero ink' },
            { label: 'Writing', detail: 'Open dispatches from below', url: '/blog/', keywords: 'blog posts essays notes' },
            { label: 'Gallery', detail: 'Open the wall of captured light', url: '/gallery/', keywords: 'photos frames pictures' },
            { label: 'Archive', detail: 'Open the pressure map', url: '/archive/', keywords: 'index tags years places system cable' },
            { label: 'Search', detail: 'Search writing and gallery together', url: '/search/', keywords: 'find content lookup' },
          ];
          const hiddenCommands = [
            { label: 'Would you kindly', detail: 'Pulse the city lights once', action: 'kindly', keywords: 'bioshock hidden easter egg', hidden: true },
            { label: 'Surface', detail: 'Return to the first breath', url: '/', keywords: 'escape top entry lighthouse', hidden: true },
            { label: 'Rapture protocol', detail: 'Open the archive cable', url: '/archive/', keywords: 'rapture city protocol', hidden: true },
          ];
          const contentState = { writing: [], gallery: [] };

          let commandCache;
          let commandPromise;
          let activeIndex = 0;
          let visibleCommands = [];
          let lastActiveElement = null;

          const normalize = (value) => String(value ?? '').toLowerCase();
          const isTypingTarget = (target) => target instanceof HTMLElement && (
            target.isContentEditable ||
            ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName)
          );
          const localUrl = (value) => {
            try {
              const url = new URL(value, window.location.href);
              return `${url.pathname}${url.search}${url.hash}`;
            } catch {
              return value;
            }
          };

          const loadCommands = async () => {
            if (commandCache) return commandCache;
            if (!commandPromise) {
              commandPromise = fetch('/content.json', { headers: { Accept: 'application/json' } })
                .then((response) => (response.ok ? response.json() : undefined))
                .then((content) => {
                  contentState.writing = Array.isArray(content?.writing) ? content.writing : [];
                  contentState.gallery = Array.isArray(content?.gallery) ? content.gallery : [];
                  const writingCommands = contentState.writing.map((entry) => ({
                    label: entry.title,
                    detail: `Writing / ${entry.readingTime ?? 'dispatch'}`,
                    url: localUrl(entry.url),
                    keywords: [entry.description, ...(entry.tags ?? [])].join(' '),
                  }));
                  const galleryCommands = contentState.gallery.map((entry) => ({
                    label: entry.title,
                    detail: `Gallery / ${entry.location ?? 'frame'}`,
                    url: localUrl(entry.url),
                    keywords: [entry.tone, entry.alt, entry.location].join(' '),
                  }));
                  const randomCommands = [
                    contentState.gallery.length
                      ? { label: 'Random frame', detail: 'Open an unpredictable photograph', action: 'random-gallery', keywords: 'photo random light' }
                      : undefined,
                    contentState.writing.length
                      ? { label: 'Random dispatch', detail: 'Open an unpredictable note', action: 'random-writing', keywords: 'post random note' }
                      : undefined,
                  ].filter(Boolean);
                  commandCache = [...staticCommands, ...randomCommands, ...writingCommands, ...galleryCommands, ...hiddenCommands];
                  return commandCache;
                })
                .catch(() => {
                  commandCache = [...staticCommands, ...hiddenCommands];
                  return commandCache;
                });
            }
            return commandPromise;
          };

          const scoreCommand = (command, query) => {
            if (!query) {
              if (command.hidden) return 0;
              return command.action?.startsWith('random') ? 7 : 5;
            }
            const label = normalize(command.label);
            const detail = normalize(command.detail);
            const keywords = normalize(command.keywords);
            if (label === query) return 100;
            if (label.startsWith(query)) return 80;
            if (label.includes(query)) return 60;
            if (detail.includes(query)) return 34;
            if (keywords.includes(query)) return 26;
            return 0;
          };

          const setActiveIndex = (index) => {
            activeIndex = Math.max(0, Math.min(index, visibleCommands.length - 1));
            const options = Array.from(results.querySelectorAll('[data-command-option]'));
            options.forEach((option, optionIndex) => {
              const selected = optionIndex === activeIndex;
              option.setAttribute('aria-selected', selected ? 'true' : 'false');
              if (selected) {
                input.setAttribute('aria-activedescendant', option.id);
                option.scrollIntoView({ block: 'nearest' });
              }
            });
          };

          const runCommand = (command) => {
            if (!command) return;
            closePalette();

            if (command.url) {
              window.location.assign(command.url);
              return;
            }

            if (command.action === 'kindly') {
              document.body.classList.add('kindly-awake');
              window.setTimeout(() => document.body.classList.remove('kindly-awake'), 1200);
              return;
            }

            if (command.action === 'random-gallery' || command.action === 'random-writing') {
              const pool = command.action === 'random-gallery' ? contentState.gallery : contentState.writing;
              const target = pool[Math.floor(Math.random() * pool.length)];
              if (target?.url) window.location.assign(localUrl(target.url));
            }
          };

          const renderCommands = async () => {
            const commands = await loadCommands();
            const query = normalize(input.value.trim());
            visibleCommands = commands
              .map((command) => ({ command, score: scoreCommand(command, query) }))
              .filter((entry) => entry.score > 0)
              .sort((a, b) => b.score - a.score)
              .slice(0, 10)
              .map((entry) => entry.command);

            results.replaceChildren();

            if (!visibleCommands.length) {
              const empty = document.createElement('p');
              empty.className = 'command-empty';
              empty.textContent = 'No signal answered.';
              results.append(empty);
              input.removeAttribute('aria-activedescendant');
              return;
            }

            visibleCommands.forEach((command, index) => {
              const button = document.createElement('button');
              button.id = `command-option-${index}`;
              button.type = 'button';
              button.setAttribute('role', 'option');
              button.setAttribute('data-command-option', '');
              button.setAttribute('aria-selected', index === activeIndex ? 'true' : 'false');

              const label = document.createElement('strong');
              label.textContent = command.label;
              const detail = document.createElement('span');
              detail.textContent = command.detail;
              button.append(label, detail);
              button.addEventListener('click', () => runCommand(command));
              results.append(button);
            });

            setActiveIndex(activeIndex);
          };

          const openPalette = async () => {
            if (!palette.hidden) return;
            lastActiveElement = document.activeElement;
            palette.hidden = false;
            document.body.classList.add('command-open');
            input.value = '';
            activeIndex = 0;
            await renderCommands();
            requestAnimationFrame(() => input.focus({ preventScroll: true }));
          };

          const closePalette = () => {
            if (palette.hidden) return;
            palette.hidden = true;
            document.body.classList.remove('command-open');
            input.value = '';
            if (lastActiveElement instanceof HTMLElement) {
              lastActiveElement.focus({ preventScroll: true });
            }
          };

          input.addEventListener('input', () => {
            activeIndex = 0;
            renderCommands();
          });

          input.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowDown') {
              event.preventDefault();
              setActiveIndex(activeIndex + 1);
            } else if (event.key === 'ArrowUp') {
              event.preventDefault();
              setActiveIndex(activeIndex - 1);
            } else if (event.key === 'Enter') {
              event.preventDefault();
              runCommand(visibleCommands[activeIndex]);
            }
          });

          closeButton?.addEventListener('click', closePalette);

          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && !palette.hidden) {
              event.preventDefault();
              closePalette();
              return;
            }

            if (event.repeat || isTypingTarget(event.target)) return;
            const wantsCommand = (event.key.toLowerCase() === 'k' && (event.ctrlKey || event.metaKey)) || event.key === '/';
            if (!wantsCommand) return;

            event.preventDefault();
            openPalette();
          });
        })();
      </script>
      <slot />
    </div>
  </body>
</html>
