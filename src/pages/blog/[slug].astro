---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, SITE_NAME } from '../../lib/site';
import { getReadingTime } from '../../lib/readingTime';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const posts = (await getCollection('blog'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = posts.findIndex((entry) => entry.id === post.id);
const newerPost = currentIndex > 0 ? posts[currentIndex - 1] : undefined;
const olderPost = currentIndex >= 0 && currentIndex < posts.length - 1 ? posts[currentIndex + 1] : undefined;
const postBody = post.body ?? '';
const { Content, headings = [] } = await render(post);
const chapterHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const postUrl = absoluteUrl(`/blog/${post.id}/`);
const postImageUrl = post.data.cover ? absoluteUrl(post.data.cover) : absoluteUrl('/favicon.png');
const postJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  url: postUrl,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  image: postImageUrl,
  keywords: post.data.tags,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE_NAME,
    url: absoluteUrl('/'),
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: absoluteUrl('/'),
    logo: {
      '@type': 'ImageObject',
      url: absoluteUrl('/icon-512.png'),
    },
  },
};
---

<BaseLayout
  title={`${post.data.title} | Rapture`}
  description={post.data.description}
  image={post.data.cover}
  type="article"
  jsonLd={postJsonLd}
>
  <main id="main-content" class="page-main article-main" tabindex="-1">
    <a class="back-link" href="/blog/">Return to dispatches</a>
    <p class="page-kicker">
      {post.data.date.toLocaleDateString('en', { month: 'long', day: '2-digit', year: 'numeric' })} / {getReadingTime(postBody)}
    </p>
    <h1 class="page-title">{post.data.title}</h1>
    <p class="page-subtitle">{post.data.description}</p>
    {post.data.cover && (
      <img class="article-cover" src={post.data.cover} alt={post.data.coverAlt ?? post.data.title} loading="eager" />
    )}
    <div class={chapterHeadings.length > 0 ? 'article-shell' : 'article-shell solo'}>
      {chapterHeadings.length > 0 && (
        <aside class="article-toc" aria-label="Article chapters">
          <p>Chapters</p>
          <nav>
            {chapterHeadings.map((heading) => (
              <a class={`depth-${heading.depth}`} href={`#${heading.slug}`} data-target={heading.slug}>{heading.text}</a>
            ))}
          </nav>
        </aside>
      )}
      <article class="content-prose">
        <Content />
      </article>
    </div>
    <nav class="entry-nav article-nav" aria-label="Adjacent articles">
      {newerPost ? (
        <a href={`/blog/${newerPost.id}/`}>
          <b>Newer dispatch</b>
          <strong>{newerPost.data.title}</strong>
        </a>
      ) : (
        <span>
          <b>Newest dispatch</b>
          <strong>You are at the glass.</strong>
        </span>
      )}
      {olderPost ? (
        <a href={`/blog/${olderPost.id}/`}>
          <b>Older dispatch</b>
          <strong>{olderPost.data.title}</strong>
        </a>
      ) : (
        <span>
          <b>Oldest dispatch</b>
          <strong>The archive ends here.</strong>
        </span>
      )}
    </nav>
  </main>
  <script is:inline src="/scripts/code-blocks.js" defer></script>
  <script is:inline>
    const fixedHeader = document.querySelector('.site-header');
    const tocLinks = Array.from(document.querySelectorAll('.article-toc a[href^="#"]'));

    if ('scrollRestoration' in window.history) {
      window.history.scrollRestoration = 'manual';
    }

    const getRootFontSize = () => parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    const getViewportHeight = () => window.visualViewport?.height ?? window.innerHeight;
    const updateViewportScrollbarOffset = () => {
      const scrollbarHalf = Math.max(0, (window.innerWidth - document.documentElement.clientWidth) / 2);
      document.documentElement.style.setProperty('--viewport-scrollbar-half', `${scrollbarHalf}px`);
    };

    const getTargetFromHash = (hash) => {
      if (!hash || hash === '#') return null;
      try {
        return document.getElementById(decodeURIComponent(hash.slice(1)));
      } catch {
        return null;
      }
    };

    const chapters = tocLinks
      .map((link) => ({
        link,
        target: link instanceof HTMLAnchorElement
          ? document.getElementById(link.dataset.target ?? decodeURIComponent(link.hash.slice(1)))
          : null,
      }))
      .filter((chapter) => chapter.link instanceof HTMLAnchorElement && chapter.target instanceof HTMLElement);

    const isCompactChapterNav = () => window.matchMedia('(max-width: 920px)').matches;
    const toPixelNumber = (value) => {
      const parsed = Number.parseFloat(value);
      return Number.isFinite(parsed) ? parsed : 0;
    };

    const getBlockerBottom = (blocker) => {
      const rect = blocker.getBoundingClientRect();
      if (rect.width <= 0 || rect.height <= 0) return 0;

      const style = getComputedStyle(blocker);
      if (style.position === 'sticky') {
        const stickyTop = toPixelNumber(style.top);
        const stuckBottom = stickyTop + rect.height;
        return rect.top > stickyTop ? stuckBottom : Math.max(rect.bottom, stuckBottom);
      }

      return rect.bottom;
    };

    const getChapterOffset = (target) => {
      const rootFontSize = getRootFontSize();
      const viewportHeight = getViewportHeight();
      const readingOffset = Math.ceil(Math.max(rootFontSize * 1.25, Math.min(viewportHeight * 0.028, rootFontSize * 2)));

      if (!window.matchMedia('(max-width: 920px)').matches) {
        return readingOffset;
      }

      const targetRect = target.getBoundingClientRect();
      const proseRect = target.closest('.content-prose')?.getBoundingClientRect();
      const targetLeft = (proseRect?.left ?? targetRect.left) - rootFontSize * 0.75;
      const targetRight = (proseRect?.right ?? targetRect.right) + rootFontSize * 0.75;
      const compactChapterNav = document.querySelector('.article-toc');
      const blockers = [
        ...(fixedHeader instanceof HTMLElement ? Array.from(fixedHeader.children) : []),
        ...(isCompactChapterNav() && compactChapterNav instanceof HTMLElement ? [compactChapterNav] : []),
      ];

      const blockingBottom = blockers.reduce((bottom, blocker) => {
        if (!(blocker instanceof HTMLElement)) return bottom;
        const rect = blocker.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) return bottom;
        const overlapsTarget = rect.right > targetLeft && rect.left < targetRight;
        return overlapsTarget ? Math.max(bottom, getBlockerBottom(blocker)) : bottom;
      }, 0);

      if (blockingBottom > 0) {
        const breathingRoom = Math.max(rootFontSize * 0.5, Math.min(viewportHeight * 0.018, rootFontSize));
        return Math.ceil(blockingBottom + breathingRoom);
      }

      return readingOffset;
    };

    let activeChapterHash = '';
    let activeUpdateFrame = 0;

    const revealChapterLink = (link) => {
      if (!link || !isCompactChapterNav()) return;
      link.scrollIntoView({
        block: 'nearest',
        inline: 'center',
        behavior: 'auto',
      });
    };

    const setActiveChapter = (hash, options = {}) => {
      if (hash === activeChapterHash) return;
      activeChapterHash = hash;
      let activeLink = null;

      chapters.forEach(({ link }) => {
        if (link.hash === hash) {
          link.setAttribute('aria-current', 'location');
          activeLink = link;
        } else {
          link.removeAttribute('aria-current');
        }
      });

      if (options.reveal) {
        revealChapterLink(activeLink);
      }
    };

    const updateActiveChapter = () => {
      if (chapters.length === 0) return;

      const probeTarget = chapters.find(({ target }) => target.getBoundingClientRect().top >= 0)?.target ?? chapters[0].target;
      const probeY = window.scrollY + getChapterOffset(probeTarget) + 2;
      let activeChapter = null;

      chapters.forEach((chapter) => {
        const chapterTop = window.scrollY + chapter.target.getBoundingClientRect().top;
        if (chapterTop <= probeY) {
          activeChapter = chapter;
        }
      });

      setActiveChapter(activeChapter?.link.hash ?? '');
    };

    const scheduleActiveChapterUpdate = () => {
      if (activeUpdateFrame) return;
      activeUpdateFrame = requestAnimationFrame(() => {
        activeUpdateFrame = 0;
        updateActiveChapter();
      });
    };

    const getChapterTop = (target) => {
      const targetTop = window.scrollY + target.getBoundingClientRect().top;
      return Math.max(0, Math.round(targetTop - getChapterOffset(target)));
    };

    const jumpToTop = (top) => {
      const root = document.documentElement;
      const previousBehavior = root.style.scrollBehavior;
      root.style.scrollBehavior = 'auto';
      window.scrollTo({ top, behavior: 'auto' });
      root.style.scrollBehavior = previousBehavior;
    };

    const alignChapter = (target) => {
      jumpToTop(getChapterTop(target));
      scheduleActiveChapterUpdate();
    };

    const scrollToChapter = (hash, mode = 'push') => {
      const target = getTargetFromHash(hash);
      if (!target) return;
      setActiveChapter(hash, { reveal: true });

      if (mode === 'replace') {
        window.history.replaceState({}, '', hash);
      } else if (mode === 'push') {
        window.history.pushState({}, '', hash);
      }

      requestAnimationFrame(() => {
        alignChapter(target);
        window.setTimeout(() => alignChapter(target), 80);
        window.setTimeout(() => alignChapter(target), 220);
        window.setTimeout(() => alignChapter(target), 520);
      });
    };

    const settleInitialChapter = (hash) => {
      const target = getTargetFromHash(hash);
      if (!target) return;
      alignChapter(target);
    };

    document.addEventListener(
      'click',
      (event) => {
        const target = event.target;
        const targetElement = target instanceof Element
          ? target
          : target instanceof Node
            ? target.parentElement
            : null;
        const link = targetElement?.closest('.article-toc a[data-target]') ?? null;
        if (!(link instanceof HTMLAnchorElement)) return;
        event.preventDefault();
        event.stopPropagation();
        scrollToChapter(`#${link.dataset.target ?? link.hash.slice(1)}`);
      },
      true
    );

    window.addEventListener('hashchange', () => {
      scrollToChapter(window.location.hash, 'replace');
    });
    window.addEventListener('scroll', scheduleActiveChapterUpdate, { passive: true });
    updateViewportScrollbarOffset();
    window.addEventListener('resize', () => {
      updateViewportScrollbarOffset();
      scheduleActiveChapterUpdate();
    }, { passive: true });
    window.addEventListener('orientationchange', () => {
      window.setTimeout(() => {
        updateViewportScrollbarOffset();
        scheduleActiveChapterUpdate();
      }, 120);
    }, { passive: true });

    const settleCurrentChapter = () => {
      if (!window.location.hash) return;
      scrollToChapter(window.location.hash, 'replace');
      settleInitialChapter(window.location.hash);
      scheduleActiveChapterUpdate();
    };

    scheduleActiveChapterUpdate();
    requestAnimationFrame(settleCurrentChapter);
    window.setTimeout(settleCurrentChapter, 0);
    window.setTimeout(settleCurrentChapter, 120);
    window.setTimeout(settleCurrentChapter, 360);
    window.setTimeout(settleCurrentChapter, 720);
    window.setTimeout(settleCurrentChapter, 1200);
    window.addEventListener('load', settleCurrentChapter, { once: true });
    document.fonts?.ready.then(settleCurrentChapter);
  </script>
</BaseLayout>

<style>
  .article-main {
    display: block;
  }

  .article-main::after {
    content: "";
    position: fixed;
    z-index: 30;
    top: 0;
    right: 0;
    left: 0;
    height: 30px;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(5, 7, 10, 0.98), rgba(5, 7, 10, 0.72) 58%, rgba(5, 7, 10, 0));
  }

  .back-link {
    margin-bottom: 36px;
    color: rgba(232, 244, 247, 0.62);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      color 220ms var(--ease-out-quint),
      transform 220ms var(--ease-out-quint);
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--brass-soft);
    transform: translateX(-4px);
    outline: none;
  }

  .article-shell {
    width: 100%;
    max-width: 1040px;
    margin-top: 54px;
    display: grid;
    grid-template-columns: minmax(180px, 230px) minmax(0, 760px);
    gap: clamp(24px, 4vw, 44px);
    align-items: start;
  }

  .article-shell.solo {
    max-width: 760px;
    display: block;
  }

  .article-shell .content-prose {
    margin-top: 0;
  }

  .article-toc {
    position: sticky;
    top: 106px;
    width: 100%;
    border-left: 1px solid rgba(240, 196, 108, 0.22);
    padding-left: 18px;
    user-select: none;
  }

  .article-toc p {
    margin: 0 0 16px;
    color: var(--brass-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .article-toc nav {
    max-height: calc(100dvh - 164px);
    display: grid;
    gap: 10px;
    overflow: auto;
    padding-right: 8px;
  }

  .article-toc a {
    position: relative;
    display: block;
    color: rgba(232, 244, 247, 0.58);
    font-size: 0.9rem;
    line-height: 1.35;
    transition:
      color 180ms var(--ease-out-quint),
      transform 180ms var(--ease-out-quint);
  }

  .article-toc a.depth-3 {
    padding-left: 14px;
    color: rgba(232, 244, 247, 0.44);
    font-size: 0.82rem;
  }

  .article-toc a:hover,
  .article-toc a:focus-visible {
    color: var(--brass-soft);
    transform: translateX(3px);
    outline: none;
  }

  .article-toc a[aria-current="location"] {
    color: var(--brass-soft);
    text-shadow: 0 0 18px rgba(240, 196, 108, 0.28);
    transform: translateX(3px);
  }

  .article-toc a[aria-current="location"]::after {
    content: "";
    position: absolute;
    top: 0.18em;
    bottom: 0.18em;
    left: -19px;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(240, 196, 108, 0.96), transparent);
    box-shadow: 0 0 16px rgba(240, 196, 108, 0.42);
  }

  .article-cover {
    width: min(100%, 980px);
    max-height: 520px;
    margin-top: 48px;
    border: 1px solid rgba(232, 244, 247, 0.14);
    border-radius: 8px;
    object-fit: cover;
    box-shadow: 0 30px 120px rgba(0, 0, 0, 0.38);
  }

  @media (max-width: 920px) {
    .article-shell {
      display: block;
      max-width: 760px;
    }

    .article-toc {
      position: sticky;
      z-index: 35;
      --mobile-toc-bridge: clamp(18px, 4dvh, 34px);
      --mobile-toc-dock-overlap: clamp(0.75rem, 1.8dvh, 1rem);
      top: calc(var(--anchor-offset) - var(--mobile-toc-dock-overlap));
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 12px;
      isolation: isolate;
      width: 100vw;
      max-width: 100vw;
      margin:
        32px
        calc(50% - 50vw - var(--viewport-scrollbar-half, 0px))
        30px
        calc(50% - 50vw + var(--viewport-scrollbar-half, 0px));
      border: 1px solid rgba(232, 244, 247, 0.1);
      border-right: 0;
      border-left: 0;
      padding: 9px max(18px, calc((100vw - 760px) / 2));
      background:
        linear-gradient(90deg, rgba(5, 7, 10, 0.94), rgba(7, 20, 28, 0.84)),
        rgba(5, 7, 10, 0.88);
      box-shadow:
        0 18px 70px rgba(0, 0, 0, 0.34),
        inset 0 1px 0 rgba(240, 196, 108, 0.08);
      backdrop-filter: blur(18px);
      touch-action: pan-y;
    }

    .article-toc::before {
      content: "";
      position: absolute;
      z-index: -1;
      right: 0;
      bottom: 100%;
      left: 0;
      height: var(--mobile-toc-bridge);
      pointer-events: none;
      background:
        linear-gradient(180deg, rgba(5, 7, 10, 0.98), rgba(5, 7, 10, 0.88)),
        radial-gradient(circle at 20% 100%, rgba(82, 217, 255, 0.06), transparent 18rem);
      box-shadow:
        0 -16px 44px rgba(0, 0, 0, 0.42),
        inset 0 1px 0 rgba(232, 244, 247, 0.055);
      backdrop-filter: blur(18px);
    }

    .article-toc p {
      margin: 0;
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      white-space: nowrap;
    }

    .article-toc nav {
      max-height: none;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      padding: 2px 0 4px;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x pan-y;
    }

    .article-toc nav::-webkit-scrollbar {
      display: none;
    }

    .article-toc a {
      flex: 0 0 auto;
      min-height: 38px;
      max-width: min(68vw, 300px);
      display: flex;
      align-items: center;
      overflow: hidden;
      padding: 0 12px;
      border: 1px solid rgba(232, 244, 247, 0.1);
      border-radius: 999px;
      background: rgba(5, 7, 10, 0.36);
      font-size: 0.82rem;
      line-height: 1;
      scroll-snap-align: center;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .article-toc a:hover,
    .article-toc a:focus-visible {
      transform: none;
    }

    .article-toc a[aria-current="location"] {
      border-color: rgba(240, 196, 108, 0.32);
      background: rgba(240, 196, 108, 0.045);
      transform: none;
    }

    .article-toc a[aria-current="location"]::after {
      top: auto;
      right: 14px;
      bottom: 7px;
      left: 14px;
      width: auto;
      height: 1px;
    }

    .article-toc a.depth-3 {
      padding-left: 12px;
      font-size: 0.78rem;
    }

    .article-toc a.depth-3::before {
      content: "";
      width: 10px;
      height: 1px;
      margin-right: 8px;
      flex: 0 0 auto;
      background: rgba(82, 217, 255, 0.28);
    }

    .article-toc a:last-child {
      margin-right: max(18px, env(safe-area-inset-right));
    }
  }
</style>
