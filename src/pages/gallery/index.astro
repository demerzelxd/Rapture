---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { photoAmbientSrc, photoThumbSrc } from '../../lib/photoImages';

const photos = (await getCollection('photos'))
  .filter((photo) => !photo.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const locationCounts = photos.reduce((counts, photo) => {
  counts.set(photo.data.location, (counts.get(photo.data.location) ?? 0) + 1);
  return counts;
}, new Map<string, number>());
const locations = [...locationCounts.entries()].sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout title="Gallery | Rapture" description="Photography from Rapture.">
  <main id="main-content" class="page-main" tabindex="-1" data-filter-scope data-filter-param="location">
    <p class="page-kicker">Gallery</p>
    <h1 class="page-title">Light held below sea level.</h1>
    <p class="page-subtitle">
      Rain, windows, sodium lamps, and the stubborn evidence that ordinary places can still feel haunted.
    </p>

    <section class="archive-tools card" aria-label="Gallery filters">
      <div class="filter-topline">
        <label class="filter-field">
          <span>Search light</span>
          <input data-filter-input type="search" placeholder="Title, city, tone..." autocomplete="off" />
        </label>
        <output class="filter-count" data-filter-count>{photos.length} / {photos.length}</output>
      </div>
      <div class="filter-options" aria-label="Gallery locations">
        <button class="filter-chip active" type="button" data-filter-option="all" aria-pressed="true">All</button>
        {locations.map(([location, count]) => (
          <button class="filter-chip" type="button" data-filter-option={location.toLowerCase()} aria-pressed="false">{location} ({count})</button>
        ))}
        <button class="filter-reset" type="button" data-filter-reset>Clear</button>
      </div>
    </section>

    <section class="gallery-grid" aria-label="Photo gallery">
      {photos.map((photo, index) => (
        <a
          class="photo-card card"
          href={`/gallery/${photo.id}/`}
          style={`--photo-ratio: ${photo.data.width} / ${photo.data.height}; --photo-ambient-image: url("${photoAmbientSrc(photo)}")`}
          data-filter-item
          data-filter-values={photo.data.location.toLowerCase()}
          data-filter-text={[photo.data.title, photo.data.location, photo.data.tone, photo.data.alt ?? ''].join(' ')}
        >
          <span class="photo-frame">
            <img src={photoThumbSrc(photo)} alt={photo.data.alt ?? photo.data.title} loading={index < 2 ? 'eager' : 'lazy'} width={photo.data.width} height={photo.data.height} />
          </span>
          <div class="photo-meta">
            <span>{photo.data.location}</span>
            <h2>{photo.data.title}</h2>
            <p>{photo.data.tone}</p>
          </div>
        </a>
      ))}
    </section>
    <p class="filter-empty" data-filter-empty hidden>No frame answered from that depth.</p>
  </main>
  <script is:inline src="/scripts/archive-filter.js" defer></script>
</BaseLayout>

<style>
  .gallery-grid {
    margin-top: 18px;
    column-count: 3;
    column-gap: 18px;
  }

  .photo-card {
    display: block;
    width: 100%;
    margin: 0 0 18px;
    break-inside: avoid;
    min-height: 0;
    transition:
      border-color 280ms var(--ease-out-quint),
      box-shadow 360ms var(--ease-out-quint),
      transform 360ms var(--ease-out-quint);
  }

  .photo-frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--photo-ratio);
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 12%, rgba(82, 217, 255, 0.1), transparent 16rem),
      rgba(5, 7, 10, 0.5);
  }

  .photo-frame::before {
    content: "";
    position: absolute;
    inset: -16%;
    background: var(--photo-ambient-image) center / cover no-repeat;
    filter: blur(24px) saturate(1.3) brightness(0.78);
    opacity: 0.68;
    transform: scale(1.08);
  }

  .photo-card img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: saturate(0.76) contrast(1.04) brightness(0.78);
    transition:
      transform 680ms var(--ease-out-quint),
      filter 680ms var(--ease-out-quint);
  }

  .photo-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(180deg, transparent 30%, rgba(5, 7, 10, 0.78)),
      radial-gradient(circle at 78% 14%, rgba(82, 217, 255, 0.2), transparent 18rem);
    pointer-events: none;
  }

  .photo-card:hover img,
  .photo-card:focus-visible img {
    transform: scale(1.06);
    filter: saturate(1.02) contrast(1.08) brightness(0.92);
  }

  .photo-card:hover,
  .photo-card:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(240, 196, 108, 0.3);
    box-shadow:
      0 0 0 1px rgba(240, 196, 108, 0.08),
      0 34px 120px rgba(0, 0, 0, 0.42);
    outline: none;
  }

  .photo-meta {
    position: absolute;
    z-index: 3;
    left: 18px;
    right: 18px;
    bottom: 18px;
  }

  .photo-meta span {
    color: var(--brass-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .photo-meta h2 {
    margin: 8px 0 4px;
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 0.95;
    transition: color 260ms var(--ease-out-quint);
  }

  .photo-card:hover .photo-meta h2,
  .photo-card:focus-visible .photo-meta h2 {
    color: var(--brass-soft);
  }

  .photo-meta p {
    margin: 0;
    color: rgba(232, 244, 247, 0.68);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .gallery-grid {
      column-count: 2;
    }
  }

  @media (max-width: 560px) {
    .gallery-grid {
      column-count: 1;
    }

    .photo-card {
      min-height: 0;
    }
  }

  @media (min-width: 760px) {
    .photo-meta h2 {
      font-size: 2.35rem;
    }
  }

  @media (min-width: 1120px) {
    .photo-meta h2 {
      font-size: 3rem;
    }
  }
</style>
