---
import BaseLayout from '../layouts/BaseLayout.astro';

const now = new Date();
const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
---

<BaseLayout
  title="Studio | Rapture"
  description="A private static authoring surface for Rapture."
  canonicalPath="/studio/"
  noindex
>
  <main id="main-content" class="page-main studio-main" tabindex="-1">
    <p class="page-kicker">Studio</p>
    <h1 class="page-title">A drafting room below the glass.</h1>
    <p class="page-subtitle">Shape a note or frame into the same MDX contract the site already publishes.</p>

    <section class="studio-shell" aria-label="Rapture content studio">
      <div class="studio-panel card">
        <div class="mode-switch" role="tablist" aria-label="Content type">
          <button class="mode-button active" type="button" data-mode="post" role="tab" aria-selected="true" aria-controls="post-panel">Writing</button>
          <button class="mode-button" type="button" data-mode="photo" role="tab" aria-selected="false" aria-controls="photo-panel">Gallery</button>
        </div>

        <form id="post-panel" class="studio-form" data-panel="post">
          <label>
            <span>Title</span>
            <input name="title" type="text" value="A note from the pressure door" autocomplete="off" />
          </label>
          <label>
            <span>Description</span>
            <input name="description" type="text" value="One short sentence for cards and metadata." autocomplete="off" />
          </label>
          <div class="field-grid">
            <label>
              <span>Date</span>
              <input name="date" type="date" value={today} />
            </label>
            <label>
              <span>Tags</span>
              <input name="tags" type="text" value="note,frontend" autocomplete="off" />
            </label>
          </div>
          <label>
            <span>Cover</span>
            <input name="cover" type="text" placeholder="/photos/frame.jpg" autocomplete="off" />
          </label>
          <label>
            <span>Cover alt</span>
            <input name="coverAlt" type="text" placeholder="Describe the cover image." autocomplete="off" />
          </label>
          <label>
            <span>Body</span>
            <textarea name="body" rows="12">Write from the room behind the glass.</textarea>
          </label>
          <label class="check-row">
            <input name="draft" type="checkbox" checked />
            <span>Draft</span>
          </label>
        </form>

        <form id="photo-panel" class="studio-form" data-panel="photo" hidden>
          <label>
            <span>Title</span>
            <input name="title" type="text" value="Light under pressure" autocomplete="off" />
          </label>
          <div class="field-grid">
            <label>
              <span>Location</span>
              <input name="location" type="text" value="Shanghai" autocomplete="off" />
            </label>
            <label>
              <span>Date</span>
              <input name="date" type="date" value={today} />
            </label>
          </div>
          <label>
            <span>Source</span>
            <input name="src" type="text" value="/photos/frame.jpg" autocomplete="off" />
          </label>
          <div class="field-grid">
            <label>
              <span>Width</span>
              <input name="width" type="number" min="1" step="1" value="1400" />
            </label>
            <label>
              <span>Height</span>
              <input name="height" type="number" min="1" step="1" value="933" />
            </label>
          </div>
          <label>
            <span>Tone</span>
            <input name="tone" type="text" value="quiet blue" autocomplete="off" />
          </label>
          <label>
            <span>Alt</span>
            <input name="alt" type="text" value="Light caught below the surface." autocomplete="off" />
          </label>
          <label>
            <span>Note</span>
            <textarea name="note" rows="8">A frame held below the surface.</textarea>
          </label>
          <label class="check-row">
            <input name="draft" type="checkbox" checked />
            <span>Draft</span>
          </label>
        </form>
      </div>

      <aside class="studio-output card" aria-label="Generated MDX">
        <div class="output-topline">
          <div>
            <span>File</span>
            <strong id="studio-file">src/content/blog/a-note-from-the-pressure-door.mdx</strong>
          </div>
          <div class="output-actions">
            <button type="button" data-action="copy">Copy</button>
            <button type="button" data-action="download">Download</button>
          </div>
        </div>
        <textarea id="studio-mdx" rows="28" spellcheck="false" readonly></textarea>
      </aside>
    </section>
  </main>

  <script is:inline>
    const storageKey = 'rapture-studio-state-v1';
    const modeButtons = Array.from(document.querySelectorAll('.mode-button'));
    const panels = Array.from(document.querySelectorAll('.studio-form'));
    const output = document.querySelector('#studio-mdx');
    const fileLabel = document.querySelector('#studio-file');
    const copyButton = document.querySelector('[data-action="copy"]');
    const downloadButton = document.querySelector('[data-action="download"]');
    let activeMode = 'post';

    const saved = readState();
    if (saved) {
      activeMode = saved.activeMode || activeMode;
      restoreForm('post', saved.post);
      restoreForm('photo', saved.photo);
    }

    setMode(activeMode);
    updateOutput();

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setMode(button.dataset.mode);
        updateOutput();
      });
    });

    panels.forEach((panel) => {
      panel.addEventListener('input', updateOutput);
      panel.addEventListener('change', updateOutput);
    });

    copyButton.addEventListener('click', async () => {
      await navigator.clipboard.writeText(output.value);
      pulse(copyButton, 'Copied');
    });

    downloadButton.addEventListener('click', () => {
      const fileName = fileLabel.textContent.split('/').pop();
      const blob = new Blob([output.value], { type: 'text/markdown;charset=utf-8' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = fileName;
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(link.href);
      pulse(downloadButton, 'Saved');
    });

    function setMode(mode) {
      activeMode = mode === 'photo' ? 'photo' : 'post';
      modeButtons.forEach((button) => {
        const selected = button.dataset.mode === activeMode;
        button.classList.toggle('active', selected);
        button.setAttribute('aria-selected', selected ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== activeMode;
      });
    }

    function updateOutput() {
      const form = currentForm();
      const data = Object.fromEntries(new FormData(form).entries());
      data.draft = form.querySelector('[name="draft"]').checked;

      const generated = activeMode === 'photo' ? renderPhoto(data) : renderPost(data);
      output.value = generated.content;
      fileLabel.textContent = generated.path;
      writeState();
    }

    function renderPost(data) {
      const title = clean(data.title) || 'Untitled note';
      const slug = slugify(title);
      const tags = toTags(data.tags);
      const body = data.body?.trim() || 'Write from the room behind the glass.';
      const lines = [
        '---',
        field('title', title),
        field('description', clean(data.description) || 'A note from below the surface.'),
        `date: ${data.date || today()}`,
        arrayField('tags', tags),
        clean(data.cover) ? field('cover', clean(data.cover)) : '',
        clean(data.coverAlt) ? field('coverAlt', clean(data.coverAlt)) : '',
        `draft: ${data.draft ? 'true' : 'false'}`,
        '---',
        '',
        body,
        '',
      ].filter((line) => line !== '');

      return {
        path: `src/content/blog/${slug}.mdx`,
        content: lines.join('\n'),
      };
    }

    function renderPhoto(data) {
      const title = clean(data.title) || 'Untitled frame';
      const slug = slugify(title);
      const lines = [
        '---',
        field('title', title),
        field('location', clean(data.location) || 'Unknown'),
        `date: ${data.date || today()}`,
        field('src', clean(data.src) || '/photos/frame.jpg'),
        `width: ${positiveInteger(data.width, 1400)}`,
        `height: ${positiveInteger(data.height, 933)}`,
        field('tone', clean(data.tone) || 'quiet pressure'),
        clean(data.alt) ? field('alt', clean(data.alt)) : '',
        `draft: ${data.draft ? 'true' : 'false'}`,
        '---',
        '',
        data.note?.trim() || 'A frame held below the surface.',
        '',
      ].filter((line) => line !== '');

      return {
        path: `src/content/photos/${slug}.mdx`,
        content: lines.join('\n'),
      };
    }

    function currentForm() {
      return document.querySelector(`.studio-form[data-panel="${activeMode}"]`);
    }

    function clean(value) {
      return String(value || '').trim();
    }

    function field(key, value) {
      return `${key}: ${JSON.stringify(String(value))}`;
    }

    function arrayField(key, values) {
      return `${key}: [${values.map((value) => JSON.stringify(value)).join(', ')}]`;
    }

    function toTags(value) {
      return String(value || 'note')
        .split(',')
        .map((tag) => tag.trim())
        .filter(Boolean);
    }

    function positiveInteger(value, fallback) {
      const parsed = Number(value);
      return Number.isInteger(parsed) && parsed > 0 ? parsed : fallback;
    }

    function slugify(value) {
      const slug = String(value)
        .normalize('NFKC')
        .trim()
        .toLowerCase()
        .replace(/['"]/g, '')
        .replace(/[^\p{Letter}\p{Number}]+/gu, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 80);
      return slug || `entry-${today()}`;
    }

    function today() {
      const now = new Date();
      const year = now.getFullYear();
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const day = String(now.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function pulse(button, text) {
      const original = button.textContent;
      button.textContent = text;
      button.dataset.done = 'true';
      setTimeout(() => {
        button.textContent = original;
        button.dataset.done = 'false';
      }, 1000);
    }

    function readState() {
      try {
        return JSON.parse(localStorage.getItem(storageKey));
      } catch {
        return undefined;
      }
    }

    function writeState() {
      localStorage.setItem(storageKey, JSON.stringify({
        activeMode,
        post: serializeForm('post'),
        photo: serializeForm('photo'),
      }));
    }

    function serializeForm(mode) {
      const form = document.querySelector(`.studio-form[data-panel="${mode}"]`);
      const data = Object.fromEntries(new FormData(form).entries());
      data.draft = form.querySelector('[name="draft"]').checked;
      return data;
    }

    function restoreForm(mode, data) {
      if (!data) return;
      const form = document.querySelector(`.studio-form[data-panel="${mode}"]`);
      Object.entries(data).forEach(([key, value]) => {
        const field = form.elements.namedItem(key);
        if (!field) return;
        if (field.type === 'checkbox') {
          field.checked = Boolean(value);
        } else {
          field.value = value;
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .studio-main {
    width: min(1320px, calc(100% - 36px));
  }

  .studio-shell {
    margin-top: 52px;
    display: grid;
    grid-template-columns: minmax(300px, 0.82fr) minmax(0, 1.18fr);
    gap: 18px;
    align-items: start;
  }

  .studio-panel,
  .studio-output {
    padding: clamp(18px, 3vw, 30px);
  }

  .mode-switch {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 24px;
    border: 1px solid rgba(232, 244, 247, 0.12);
    border-radius: 999px;
    padding: 6px;
    background: rgba(5, 7, 10, 0.46);
    user-select: none;
  }

  .mode-button,
  .output-actions button {
    min-height: 42px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: rgba(232, 244, 247, 0.68);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      border-color 220ms var(--ease-out-quint),
      background 220ms var(--ease-out-quint),
      color 220ms var(--ease-out-quint),
      transform 220ms var(--ease-out-quint);
  }

  .mode-button:hover,
  .mode-button:focus-visible,
  .output-actions button:hover,
  .output-actions button:focus-visible {
    color: white;
    background: rgba(232, 244, 247, 0.08);
    outline: none;
  }

  .mode-button.active {
    border-color: rgba(240, 196, 108, 0.22);
    background:
      radial-gradient(circle at 50% 130%, rgba(240, 196, 108, 0.2), transparent 62%),
      rgba(7, 20, 28, 0.68);
    color: var(--mist);
  }

  .studio-form {
    display: grid;
    gap: 14px;
  }

  .studio-form[hidden] {
    display: none;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .studio-form label {
    display: grid;
    gap: 8px;
  }

  .studio-form span,
  .output-topline span {
    color: var(--brass-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    user-select: none;
  }

  .studio-form input,
  .studio-form textarea,
  #studio-mdx {
    width: 100%;
    border: 1px solid rgba(232, 244, 247, 0.13);
    border-radius: 8px;
    background: rgba(5, 7, 10, 0.58);
    color: rgba(232, 244, 247, 0.88);
    caret-color: var(--brass-soft);
    font: inherit;
    line-height: 1.55;
    outline: none;
    transition:
      border-color 220ms var(--ease-out-quint),
      box-shadow 220ms var(--ease-out-quint),
      background 220ms var(--ease-out-quint);
  }

  .studio-form input {
    min-height: 46px;
    padding: 0 13px;
  }

  .studio-form textarea,
  #studio-mdx {
    resize: vertical;
    padding: 13px;
  }

  .studio-form input:focus,
  .studio-form textarea:focus,
  #studio-mdx:focus {
    border-color: rgba(82, 217, 255, 0.38);
    background: rgba(5, 7, 10, 0.72);
    box-shadow:
      inset 0 0 0 1px rgba(82, 217, 255, 0.1),
      0 0 0 4px rgba(82, 217, 255, 0.06);
  }

  .studio-form input::placeholder,
  .studio-form textarea::placeholder {
    color: rgba(232, 244, 247, 0.32);
  }

  .check-row {
    min-height: 44px;
    display: inline-flex !important;
    align-items: center;
    gap: 10px !important;
    width: fit-content;
    user-select: none;
  }

  .check-row input {
    width: 18px;
    min-height: 18px;
    accent-color: var(--brass-soft);
  }

  .studio-output {
    position: sticky;
    top: 96px;
  }

  .output-topline {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .output-topline strong {
    display: block;
    max-width: 560px;
    margin-top: 7px;
    color: rgba(232, 244, 247, 0.78);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .output-actions {
    display: flex;
    flex: 0 0 auto;
    gap: 8px;
  }

  .output-actions button {
    min-width: 92px;
    border-color: rgba(232, 244, 247, 0.12);
    background: rgba(5, 7, 10, 0.42);
  }

  .output-actions button[data-done="true"] {
    border-color: rgba(240, 196, 108, 0.38);
    color: var(--brass-soft);
  }

  #studio-mdx {
    min-height: 560px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    white-space: pre;
  }

  @media (max-width: 980px) {
    .studio-shell {
      grid-template-columns: 1fr;
    }

    .studio-output {
      position: relative;
      top: auto;
    }
  }

  @media (max-width: 620px) {
    .studio-main {
      width: min(100% - 28px, 1320px);
    }

    .field-grid,
    .output-topline {
      grid-template-columns: 1fr;
      display: grid;
    }

    .output-actions {
      width: 100%;
    }

    .output-actions button {
      flex: 1;
    }

    #studio-mdx {
      min-height: 420px;
    }
  }
</style>
